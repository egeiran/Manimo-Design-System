# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ElevenLabs TTS — used by scripts/generate-audio.js
ELEVENLABS_API_KEY=

# Supabase (kort-forklart project) — used by scripts/publish-scene.js
# Find both under: Project Settings → API in the Supabase dashboard.
# The service-role key bypasses RLS — keep it in this local .env only,
# never in any client app or git.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
