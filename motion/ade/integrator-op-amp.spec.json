            "type": "svg-path",
            "content": "R from V_in node to V- node",
            "delay": 0.8,
            "color": "var(--amber-400)"
          },
          {
            "type": "svg-path",
            "content": "C from V_out node back to V- node",
            "delay": 1.3,
            "color": "var(--rose-400)"
          },
          {
            "type": "svg-path",
            "content": "Ground symbol on V+ input",
            "delay": 1.7,
            "color": "var(--chalk-300)"
          },
          {
            "type": "svg-label",
            "content": "V_in, V-, V_out labels",
            "delay": 2,
            "color": "var(--chalk-200)"
          },
          {
            "type": "text-caption",
            "content": "the cap in feedback turns time into voltage",
            "delay": 7,
