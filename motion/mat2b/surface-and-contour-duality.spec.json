    {
      "id": "takeaway",
      "start": 37.36,
      "end": 48,
      "narration": "A surface and its contour map are the same picture — one folded up into 3D, the other flat. The map is just the surface, seen from above.",
      "visuals": {
        "layout": "center",
        "elements": [
          {
            "type": "text-title",
            "content": "Same hill, seen from above.",
            "delay": 0.2,
            "color": "var(--chalk-100)",
            "position": "centre serif italic large"
          },
          {
            "type": "text-caption",
            "content": "Each contour is one height — the surface flattened, not lost.",
            "delay": 1.6,
            "color": "var(--chalk-300)",
            "position": "centre below title"
          }
        ]
