{
  "id": "change-of-basis-matrix",
  "subject_id": "mat2b",
  "chapter_number": 2,
  "week": 5,
  "title": "Change of Basis: P Converts the Reading",
  "eyebrow": "coordinate vectors",
  "language": "en",
  "duration": 38,
  "topic": "Change-of-basis matrix — the same vector has different coordinate readings in two bases. Stack the new basis vectors as columns of P; then P times the new-basis coordinates returns the standard-basis coordinates of the same vector.",
  "concepts": [
    "basis",
    "coordinate vector",
    "change of basis",
    "transition matrix",
    "linear combination"
  ],
  "pairs_with": [
    "chapter_concepts: koordinatvektor",
    "chapter_concepts: basisbytte",
    "chapter_concepts: overgangsmatrise"
  ],
  "prerequisites": ["basis-change-grid"],
  "beats": [
    {
      "id": "manimoIntro",
      "start": 0,
      "end": 4.18,
      "narration": "Same arrow, two readings. How do you convert between them?",
      "visuals": { "layout": "center", "elements": [
        { "type": "manimo-enter", "content": "Manimo bobs centre-screen", "delay": 0 },
        { "type": "text-caption", "content": "Hook caption", "delay": 0.7, "color": "var(--chalk-100)", "position": "right of Manimo" }
      ]}
    },
    {
      "id": "twoFrames",
      "start": 4.18,
      "end": 16.51,
      "narration": "Here is a vector v. The standard basis reads it as one across and two up. A tilted basis B with two slanted axes reads the same arrow as one of b one plus one of b two.",
      "visuals": { "layout": "left-diagram + right-panel", "elements": [
        { "type": "svg-grid", "content": "Standard grid chalk-300", "delay": 0.0, "color": "var(--chalk-300)" },
        { "type": "svg-grid", "content": "B-basis tilted grid in amber-400 faint", "delay": 0.3, "color": "var(--amber-400)" },
        { "type": "svg-vector", "content": "b₁ violet", "delay": 0.6, "color": "var(--violet-400)" },
        { "type": "svg-vector", "content": "b₂ teal", "delay": 0.9, "color": "var(--teal-400)" },
        { "type": "svg-vector", "content": "v in rose — the same arrow", "delay": 1.4, "color": "var(--rose-400)" },
        { "type": "text-readings", "content": "[v]_std = (1, 2);   [v]_B = (1, 1)", "delay": 3.6, "color": "var(--chalk-100)", "position": "right" }
      ]}
    },
    {
      "id": "matrixP",
      "start": 16.51,
      "end": 25.29,
      "narration": "Stack the new basis vectors as columns of a matrix P. Multiplying P by the B-coordinates of v gives back its standard coordinates.",
      "visuals": { "layout": "left-diagram + right-panel", "elements": [
        { "type": "matrix-panel", "content": "P = [b₁ | b₂]", "delay": 0.0, "color": "var(--chalk-100)", "position": "right" },
        { "type": "text-formula", "content": "P · [v]_B = [v]_std", "delay": 2.0, "color": "var(--amber-300)", "position": "right" },
        { "type": "svg-arrow", "content": "Arrow from [v]_B box to [v]_std box, labelled P", "delay": 4.0, "color": "var(--amber-300)" }
      ]}
    },
    {
      "id": "verify",
      "start": 25.29,
      "end": 31.56,
      "narration": "Plug in the numbers. P times one comma one gives one comma two — exactly the standard reading.",
      "visuals": { "layout": "left-diagram + right-panel", "elements": [
        { "type": "text-formula", "content": "P · (1, 1) = (1·b₁ + 1·b₂) = (1, 2)", "delay": 0.4, "color": "var(--chalk-100)", "position": "right" },
        { "type": "svg-highlight", "content": "v glows emerald — same arrow, verified", "delay": 1.6, "color": "var(--emerald-400)" }
      ]}
    },
    {
      "id": "heroOutro",
      "start": 31.56,
      "end": 38.0,
      "narration": "The change-of-basis matrix is just the new basis, written as columns. Stack and multiply.",
      "visuals": { "layout": "center", "elements": [
        { "type": "text-eyebrow", "content": "'CHANGE OF BASIS'", "delay": 0.0, "color": "var(--amber-300)", "position": "centre-top" },
        { "type": "text-hero", "content": "'P = [b₁ | b₂]'", "delay": 0.35, "color": "var(--chalk-100)", "position": "centre" },
        { "type": "text-caption", "content": "Columns are the new basis. Multiply to translate.", "delay": 1.4, "color": "var(--chalk-200)", "position": "below hero" }
      ]}
    }
  ]
}
