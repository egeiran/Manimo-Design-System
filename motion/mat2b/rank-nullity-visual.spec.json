  "title": "Rank, Nullity, and a Squashed Plane",
  "eyebrow": "linear transformations",
  "language": "en",
  "duration": 40,
  "topic": "Rank-nullity by example — a singular 2×2 matrix squashes the whole plane down to a line. The image is that surviving line (rank one); the kernel is the direction that collapsed onto the origin (nullity one). Their dimensions add up to the dimension of the domain.",
  "concepts": [
    "rank",
    "nullity",
    "kernel",
    "image",
    "rank-nullity theorem",
    "singular matrix"
  ],
  "pairs_with": [
    "chapter_concepts: kjerne",
    "chapter_concepts: rang",
    "chapter_concepts: rangteorem"
  ],
  "prerequisites": [
    "linear-transformation-grid"
  ],
  "beats": [
