{
  "id": "rlc-pendulum",
  "title": "RLC and Pendulum: Same Math, Different Physics",
  "eyebrow": "analogy",
  "language": "en",
  "duration": 48,
  "topic": "RLC ↔ pendulum analogy — both obey the same second-order linear ODE, with q↔x, I↔v, L↔m, 1/C↔k, R↔b",
  "prerequisites": ["spring-oscillation", "pendulum", "rc-circuit"],
  "beats": [
    {
      "id": "manimoIntro",
      "start": 0,
      "end": 4.9,
      "narration": "A swinging weight and a flowing current — could they really obey the same rule?",
      "visuals": {
        "layout": "center",
        "elements": [
          { "type": "manimo-enter", "content": "Manimo bobs in centre-screen", "delay": 0 },
          { "type": "text-caption", "content": "A swinging weight, a flowing current — same rule?", "delay": 0.7, "color": "var(--chalk-100)", "position": "right of Manimo, serif italic" }
        ]
      }
    },
    {
      "id": "sideBySide",
      "start": 4.9,
      "end": 12.75,
      "narration": "The pendulum swings back and forth, and the current in the circuit sloshes between coil and capacitor in exactly the same rhythm.",
      "visuals": {
        "layout": "left-right",
        "elements": [
          { "type": "svg-label", "content": "MECHANICAL label above pendulum", "delay": 0.3, "color": "var(--chalk-300)", "position": "top of left column, mono eyebrow" },
          { "type": "svg-path", "content": "Pendulum on left half — SwingingPendulum, period 2.4s, amber", "delay": 0.5, "color": "var(--amber-400)" },
          { "type": "svg-label", "content": "ELECTRICAL label above circuit", "delay": 0.3, "color": "var(--chalk-300)", "position": "top of right column, mono eyebrow" },
          { "type": "svg-path", "content": "LC tank circuit on right — inductor coil + capacitor with current arrows oscillating in same rhythm", "delay": 0.8, "color": "var(--amber-400)" },
          { "type": "svg-circle", "content": "Charge dots animate up/down with same period as pendulum — accumulating on plates at peaks", "delay": 1.2, "color": "var(--rose-400)" },
          { "type": "text-caption", "content": "same rhythm, totally different systems", "delay": 4.5, "color": "var(--chalk-300)", "position": "bottom-center, sans 14" }
        ]
      }
    },
    {
      "id": "mappingTable",
      "start": 12.75,
      "end": 21.4,
      "narration": "Position becomes charge, velocity becomes current, mass becomes inductance, and spring stiffness becomes one over capacitance.",
      "visuals": {
        "layout": "center",
        "elements": [
          { "type": "text-title", "content": "MECHANICAL", "delay": 0, "color": "var(--chalk-300)", "position": "left column header, mono uppercase" },
          { "type": "text-title", "content": "ELECTRICAL", "delay": 0, "color": "var(--chalk-300)", "position": "right column header, mono uppercase" },
          { "type": "text-formula", "content": "x   ↔   q", "delay": 0.4, "color": "var(--chalk-100)", "position": "row 1, large serif italic" },
          { "type": "text-caption", "content": "position ↔ charge", "delay": 0.7, "color": "var(--chalk-300)", "position": "row 1, sans caption below symbols" },
          { "type": "text-formula", "content": "v   ↔   I", "delay": 1.7, "color": "var(--chalk-100)", "position": "row 2" },
          { "type": "text-caption", "content": "velocity ↔ current", "delay": 2.0, "color": "var(--chalk-300)", "position": "row 2 caption" },
          { "type": "text-formula", "content": "m   ↔   L", "delay": 3.4, "color": "var(--amber-300)", "position": "row 3, amber for emphasis" },
          { "type": "text-caption", "content": "inertia ↔ inductance", "delay": 3.7, "color": "var(--chalk-300)", "position": "row 3 caption" },
          { "type": "text-formula", "content": "k   ↔   1/C", "delay": 5.4, "color": "var(--amber-300)", "position": "row 4, amber for emphasis" },
          { "type": "text-caption", "content": "stiffness ↔ capacitance", "delay": 5.7, "color": "var(--chalk-300)", "position": "row 4 caption" }
        ]
      }
    },
    {
      "id": "equationReveal",
      "start": 21.4,
      "end": 34.13,
      "narration": "Both systems obey the same second-order differential equation. The natural frequency for the pendulum is the square root of k over m, and for the circuit, one over the square root of L times C.",
      "visuals": {
        "layout": "center",
        "elements": [
          { "type": "text-formula", "content": "m·d²x/dt² + b·dx/dt + k·x = 0", "delay": 0.3, "color": "var(--chalk-100)", "position": "left, large serif italic" },
          { "type": "text-formula", "content": "L·d²q/dt² + R·dq/dt + (1/C)·q = 0", "delay": 1.6, "color": "var(--chalk-100)", "position": "right, large serif italic" },
          { "type": "text-caption", "content": "same structure — only the letters differ", "delay": 3.4, "color": "var(--chalk-300)", "position": "below both equations, sans 14" },
          { "type": "text-formula", "content": "ω₀ = √(k/m)", "delay": 5.6, "color": "var(--amber-300)", "position": "left payoff, large amber" },
          { "type": "text-formula", "content": "ω₀ = 1/√(LC)", "delay": 7.4, "color": "var(--amber-300)", "position": "right payoff, large amber" }
        ]
      }
    },
    {
      "id": "dampingAdded",
      "start": 34.13,
      "end": 41.69,
      "narration": "Add resistance to the circuit or friction to the pendulum — both decay, and the amplitude falls exponentially toward zero.",
      "visuals": {
        "layout": "left-right",
        "elements": [
          { "type": "svg-path", "content": "Damped pendulum on left — Pendulum with angle = A·exp(-γt)·cos(2π t/T)", "delay": 0.3, "color": "var(--amber-400)" },
          { "type": "svg-label", "content": "+ FRICTION label, rose tag near pendulum bob", "delay": 1.0, "color": "var(--rose-300)", "position": "near pendulum, mono caption" },
          { "type": "svg-path", "content": "Damped oscilloscope curve on right — exponentially decaying sinusoid drawn with TraceIn", "delay": 0.6, "color": "var(--amber-400)" },
          { "type": "svg-path", "content": "Exponential envelope (dashed) above and below the curve", "delay": 2.2, "color": "var(--rose-400)" },
          { "type": "svg-label", "content": "+ RESISTANCE label near curve", "delay": 1.0, "color": "var(--rose-300)", "position": "near curve, mono caption" },
          { "type": "text-caption", "content": "amplitude decays exponentially", "delay": 5.0, "color": "var(--chalk-300)", "position": "bottom-center, sans 14" }
        ]
      }
    },
    {
      "id": "takeaway",
      "start": 41.69,
      "end": 48,
      "narration": "Same math, different physics. Once you understand one, you understand the other.",
      "visuals": {
        "layout": "center",
        "elements": [
          { "type": "text-caption", "content": "Same math, different physics.", "delay": 0.3, "color": "var(--chalk-100)", "position": "centre, serif italic ~28px" },
          { "type": "text-caption", "content": "Once you understand one, you understand the other.", "delay": 1.4, "color": "var(--amber-300)", "position": "centre, serif italic ~22px below" }
        ]
      }
    }
  ]
}
