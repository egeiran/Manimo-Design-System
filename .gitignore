# Snapshot output (regenerated per run, not source of truth)
.tmp/

# Rendered videos (regenerated per run, not source of truth)
renders/

# Snapshot / render temp HTML — written by scripts/snapshot-scene.js and
# scripts/render-scene.js when motion/vendor/ is populated; rewrites unpkg
# <script> tags to local paths. Deleted on exit but pattern guards against
# orphaned files from interrupted runs.
motion/.*.snapshot.html
motion/.*.render.html

# Node
node_modules/
npm-debug.log*

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Local credentials — never commit
.env
.env.local
