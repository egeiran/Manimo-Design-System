      "start": 18.7,
      "end": 21,
      "props": {
        "code": "mergeSort(a):\n  if len(a) <= 1:          # already sorted\n    return a\n  mid = len(a) // 2\n  L = mergeSort(a[:mid])   # split + recurse\n  R = mergeSort(a[mid:])\n  return merge(L, R)       # combine\n\nmerge(L, R):\n  out = []\n  while L and R:           # compare fronts\n    if L[0] <= R[0]: out += [L.pop(0)]\n    else:            out += [R.pop(0)]\n  return out + L + R       # leftovers",
        "title": "merge sort · pseudocode",
        "highlight": "",
        "reveal": "lines",
        "fontSize": 19,
        "duration": 2,
        "accent": "var(--amber-400)"
      }
    },
